# Copy this file to .env and replace the placeholder values.
# Never commit .env or real credentials.

# HTTP server
PORT=3000
NODE_ENV=development

# MongoDB connection string with a database name
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-host>/buildbridge?retryWrites=true&w=majority

# Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated allowed web origins
CLIENT_URL=http://localhost:5173
PUBLIC_URL=http://localhost:3000

# Uploads: auto uses Cloudinary when all three credentials exist, otherwise local disk.
# Set to local for offline development, or cloudinary to require the CDN.
UPLOAD_DRIVER=auto
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=buildbridge
